{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanproblem",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "build": {
    "command": "npm run cf:build"
  },
  "observability": {
    "enabled": true
  },
  // ランタイム env vars (process.env.X として読める)。
  // wrangler deploy はここに定義された vars で remote の Variables を上書きするため、
  // ダッシュボード側で設定しても次回デプロイで消える。設定はこのファイルが信頼源。
  // 機密情報は wrangler secret put で別管理 (vars には平文OKなものだけ)。
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://wanproblem.com",
    "RAKUTEN_AFFILIATE_ID": "539e4e74.6ad56816.539e4e75.134f4a19"
  }
}
